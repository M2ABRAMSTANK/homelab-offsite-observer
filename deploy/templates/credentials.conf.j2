# Managed by deploy/install.yml; no secret values belong here.
[Service]
{% if (observer_flags.stdout | from_json).native %}
LoadCredential=heartbeat_token:/etc/offsite-observer/heartbeat.token
LoadCredential=telegram_chat:/etc/offsite-observer/telegram_chat.token
{% endif %}
{% if (observer_flags.stdout | from_json).private %}
LoadCredential=private_token:/etc/offsite-observer/private.token
{% endif %}
